{
  "name": "@threatmap/threatmap",
  "private": true,
  "scripts": {
    "lint": "eslint \"packages/**/src/**/*.{ts,vue,js}\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r build && pnpm -r typecheck",
    "knip": "knip",
    "create-plugin": "node tools/create-plugin/dist/index.mjs",
    "generate:doc": "pnpm -r generate:doc"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=10.17"
  },
  "devDependencies": {
    "@threatmap/eslint-config": "workspace:*",
    "eslint": "9.39.2",
    "knip": "5.82.1",
    "prettier": "3.9.9",
    "tsdown": "0.20.1",
    "typedoc": "0.28.14",
    "typedoc-plugin-markdown": "4.9.0",
    "typedoc-plugin-missing-exports": "4.1.2",
    "typescript": "5.6.2"
  }
}
