{
  "name": "@threatmap/server-auth",
  "version": "0.1.0",
  "description": "Authenticate with a Threatmap instance",
  "author": "ThreatCode <dev@khulnasoft.com>",
  "repository": "https://github.com/threatcode/threatmap/",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist/*"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@urql/core": "^6.0.0",
    "graphql": "^16.12.0",
    "graphql-tag": "^2.12.0",
    "graphql-ws": "^6.0.0"
  }
}
