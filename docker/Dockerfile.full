# syntax=docker/dockerfile:1

# Arguments
ARG NODE_VERSION=24
ARG RUST_VERSION=1.85.0
ARG TARGETARCH

# ---------------------------------------------------------------------------
# Stage 1: builder — install toolchain, install deps, build all packages
# ---------------------------------------------------------------------------
FROM node:${NODE_VERSION}-bookworm AS builder

ARG RUST_VERSION
ARG TARGETARCH

ENV PNPM_HOME=/root/.local/share/pnpm
ENV PATH=${PNPM_HOME}:${PATH}
ENV RUSTUP_HOME=/usr/local/rustup
ENV CARGO_HOME=/usr/local/cargo
ENV PATH=${CARGO_HOME}/bin:${PATH}

RUN \
  apt-get update && \
  apt-get install -y --no-install-recommends ca-certificates curl build-essential pkg-config libssl-dev && \
  corepack enable && \
  corepack prepare pnpm@11.28.0 --activate && \
  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain "${RUST_VERSION}" --profile minimal --components clippy,rustfmt && \
  apt-get clean && \
  rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# Install dependencies first (better layer caching)
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
RUN pnpm install --frozen-lockfile

# Copy sources and build
COPY . .
RUN pnpm -r --if-present build

# ---------------------------------------------------------------------------
# Stage 2: runtime — slim image with only what is needed to run ThreatMap
# ---------------------------------------------------------------------------
FROM node:${NODE_VERSION}-slim AS runtime

ARG TARGETARCH

ENV PNPM_HOME=/root/.local/share/pnpm
ENV PATH=${PNPM_HOME}:${PATH}
ENV NODE_ENV=production

RUN \
  apt-get update && \
  apt-get install -y --no-install-recommends ca-certificates tini && \
  apt-get clean && \
  rm -rf /var/lib/apt/lists/*

COPY --from=builder ${PNPM_HOME} ${PNPM_HOME}
COPY --from=builder /workspace/node_modules /workspace/node_modules
COPY --from=builder /workspace/packages /workspace/packages
COPY --from=builder /workspace/crates /workspace/crates
COPY --from=builder /workspace/package.json /workspace/package.json
COPY --from=builder /workspace/pnpm-workspace.yaml /workspace/pnpm-workspace.yaml
COPY --from=builder /workspace/pnpm-lock.yaml /workspace/pnpm-lock.yaml
COPY --from=builder /workspace/.npmrc /workspace/.npmrc

WORKDIR /workspace

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "packages/cli/src/cli.ts", "--help"]
